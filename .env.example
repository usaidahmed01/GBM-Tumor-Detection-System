# GBM CDSS Backend — development example only
# Copy to .env and change credentials for your machine.

GBM_ENVIRONMENT=development
GBM_DEBUG=true
GBM_HOST=127.0.0.1
GBM_PORT=8000

# PostgreSQL via SQLAlchemy + psycopg 3
GBM_DATABASE_URL=postgresql+psycopg://gbm_cdss:CHANGE_ME@localhost:5432/gbm_cdss

# Connection-pool settings
GBM_DB_POOL_SIZE=5
GBM_DB_MAX_OVERFLOW=5
GBM_DB_POOL_TIMEOUT_SECONDS=30

# API metadata
GBM_API_V1_PREFIX=/api/v1
GBM_APP_VERSION=0.4.1
