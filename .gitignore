# ============================================================================
# GBM CDSS — repository hygiene
# Keep source code, migrations, configs/examples, tests, README files,
# metric summaries and lightweight plots. Do NOT commit patient/MRI data,
# local storage, secrets, databases, model weights or runtime caches.
# ============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/
ENV/

# Secrets / local configuration
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Logs / runtime
*.log
logs/
tmp/
temp/
*.pid

# Local PostgreSQL / SQLite / DB dumps
*.db
*.sqlite
*.sqlite3
*.sql
*.dump
*.backup
pgdata/
postgres-data/

# ---------------------------------------------------------------------------
# PROJECT DATA — never push supplied/raw/interim/processed MRI datasets
# ---------------------------------------------------------------------------
/data/

# Common medical image formats anywhere outside intentionally versioned fixtures
*.dcm
*.dicom
*.ima
*.nii
*.nii.gz
*.nrrd
*.mha
*.mhd

# Uploaded archives / raw study packages
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz

# ---------------------------------------------------------------------------
# PROTECTED LOCAL OBJECT STORAGE — NEVER PUSH
# ---------------------------------------------------------------------------
/var/storage/
/var/uploads/
/storage/
/uploads/
/object-storage/

# Any working copies/de-identified study files generated at runtime
/work/
/working/
/derived/
/deidentified/

# ---------------------------------------------------------------------------
# MODEL WEIGHTS / LARGE MODEL EXPORTS — NEVER PUSH
# ---------------------------------------------------------------------------
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.h5
*.keras
*.tflite
*.joblib
*.pkl

# Explicit checkpoint trees
/artifacts/experiments/**/checkpoints/
/artifacts/baseline_experiments/**/checkpoints/
/artifacts/**/checkpoints/

# Large/generated Grad-CAM or review image exports
/artifacts/safety/gradcam_false_negative_review/images/
/artifacts/**/review_images/
/artifacts/**/images/

# Generated masks / volumetric outputs later in the roadmap
/artifacts/**/masks/
/artifacts/**/segmentations/
/artifacts/**/volumes/

# Generated reports containing case-level information later
/artifacts/**/reports/
/reports/

# Local notebook scratch
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# Torch / Hugging Face / MONAI caches
.torch/
torch_cache/
.cache/
huggingface/
monai_cache/

# Optional profiling / temporary training outputs
*.prof
*.trace
*.tmp
*.part

# ============================================================================
# INTENTIONALLY COMMITTED:
# - src/
# - tests/
# - migrations/
# - alembic.ini
# - requirements.txt
# - .env.example
# - README*.md
# - lightweight artifacts/*.json, *.csv, *.png summaries/plots where useful
# - model cards / safety policies / metric summaries
# ============================================================================
